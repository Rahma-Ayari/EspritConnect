# Copy to application-local.properties (same folder). That file is gitignored — never commit real keys.

# ========== Brevo SMTP (single mail provider) ==========
BREVO_SMTP_USERNAME=your-login@smtp-brevo.com
BREVO_SMTP_PASSWORD=xsmtpsib-your-brevo-smtp-key
BREVO_MAIL_FROM=your-verified-sender@yourdomain.com
spring.mail.username=${BREVO_SMTP_USERNAME}
spring.mail.password=${BREVO_SMTP_PASSWORD}
spring.mail.properties.mail.smtp.from=${BREVO_MAIL_FROM}
app.mail.from=${BREVO_MAIL_FROM}

# ========== Groq chatbot (optional) ==========
# Get a free key: https://console.groq.com/keys
#app.chatbot.api-key=your-groq-api-key
